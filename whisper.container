[Container]
Image=docker.io/rhasspy/wyoming-whisper:3.9.0@sha256:3cc01f646c8b149fe47b2a5e8bfaf31866e1bc18faffadb26c9b8be58cbe5703
ContainerName=whisper

PublishPort=127.0.0.1:10300:10300

Volume=%h/containers/whisper:/data:U,Z

ReadOnly=true
ReadOnlyTmpfs=false
Tmpfs=/tmp:noexec,nosuid

User=1000
Group=1000
UserNS=auto
NoNewPrivileges=true
DropCapability=all

Exec=--model tiny-int8 --language en

HealthCmd=["/usr/src/.venv/bin/python3", "-m", "wyoming_faster_whisper.health_check"]
HealthStartupInterval=5s
HealthStartupTimeout=5s
HealthInterval=30s
HealthTimeout=20s
HealthOnFailure=kill
Notify=healthy

Memory=512M
PidsLimit=50

[Service]
CPUQuota=200%
Restart=always
RestartSec=5s
ExecStartPre=mkdir -p -m 0700 %h/containers/whisper

[Install]
WantedBy=default.target
