[Container]
Image=docker.io/rhasspy/wyoming-piper:2.5.4@sha256:333622ab9e4bcd00c80a37219b90a1a9d6aa3fd1ad34e0a6e3bddd36ee999efd
ContainerName=piper

PublishPort=127.0.0.1:10200:10200

Volume=%h/containers/piper:/data:U,Z

ReadOnly=true
ReadOnlyTmpfs=false
Tmpfs=/tmp:noexec,nosuid

User=1000
Group=1000
UserNS=auto
NoNewPrivileges=true
DropCapability=all

Exec=--voice en_US-lessac-medium

HealthCmd=["/usr/src/.venv/bin/python3", "-m", "wyoming_piper.health_check"]
HealthStartupInterval=5s
HealthStartupTimeout=5s
HealthInterval=30s
HealthTimeout=20s
HealthOnFailure=kill
Notify=healthy

Memory=512M
PidsLimit=50

[Service]
CPUQuota=100%
Restart=always
RestartSec=5s
ExecStartPre=mkdir -p -m 0700 %h/containers/piper

[Install]
WantedBy=default.target
