[Container]
Image=ghcr.io/home-assistant/home-assistant:2026.11.2@sha256:493a07e8f6530fc640223f4a0a5248f20a61ca2f718bb1d31efbf08a2c5ea28f
ContainerName=home-assistant

Network=host

Timezone=local

Volume=%h/containers/home-assistant:/config:U,Z

UserNS=auto
NoNewPrivileges=true
DropCapability=all

HealthCmd=wget --no-verbose --tries=1 --spider http://localhost:8123/ || exit 1
HealthStartupInterval=5s
HealthStartupTimeout=5s
HealthInterval=60s
HealthTimeout=5s
HealthOnFailure=kill
Notify=healthy

StopTimeout=60

Memory=1.5G
PidsLimit=256

[Service]
CPUQuota=200%
Restart=always
RestartSec=5s
ExecStartPre=mkdir -p -m 0700 %h/containers/home-assistant

[Install]
WantedBy=default.target
